# =====================================================================
# survey_ai_agent 环境配置模板
# 复制为 .env 后填写。所有变量也支持系统环境变量覆盖。
# =====================================================================

# ---- 模型 ----
# deepseek: 必须真实调用；未配置 Key 时接口返回 502 llm_not_configured
# mock:     确定性规则模式，只使用受访者资料/历史，不编造答案（测试用）
# auto:     有 Key 用 deepseek，否则 mock
SURVEY_AI_LLM_MODE=deepseek

# DeepSeek OpenAI-compatible API
# 兼容变量名：DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL
SURVEY_AI_DEEPSEEK_API_KEY=
SURVEY_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
# API 模型别名（示例：deepseek-chat）。如需固定版本，填写服务商提供的版本化模型 ID。
SURVEY_AI_DEEPSEEK_MODEL=deepseek-chat
SURVEY_AI_LLM_TIMEOUT_SECONDS=60
SURVEY_AI_LLM_MAX_RETRIES=2

# ---- MySQL / MariaDB（与 survey_bg_manage 共用同一个库） ----
# 也兼容 survey_bg_manage 的 SB_DB_* 变量名。
SURVEY_AI_DB_HOST=127.0.0.1
SURVEY_AI_DB_PORT=3306
SURVEY_AI_DB_USER=root
SURVEY_AI_DB_PASSWORD=
SURVEY_AI_DB_NAME=survey_bg_manage
SURVEY_AI_DB_AUTO_INIT=true

# ---- 服务 ----
SURVEY_AI_HOST=127.0.0.1
SURVEY_AI_PORT=8790
SURVEY_AI_LOG_LEVEL=INFO
